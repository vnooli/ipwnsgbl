# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS - comma separated origins allowed to call this API (the UI's origin)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Elexon BMRS Insights API (no key required for these public datasets)
ELEXON_API_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Procurement decision cutoff: hour (0-23) in Europe/London local time on the
# day BEFORE delivery, by which a forecast must have been published to be
# eligible for that day-ahead purchasing decision. Default 11:00, matching the
# UK day-ahead (EPEX/N2EX) gate-closure window which falls late morning D-1.
# This is a documented assumption, not an official market rule - see README.
DECISION_CUTOFF_HOUR=11

# How long fetched Elexon responses are cached in-memory, in seconds.
ELEXON_CACHE_TTL_SECONDS=900
